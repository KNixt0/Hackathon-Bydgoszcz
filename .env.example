# Copy to .env and change the values. These are placeholders, not real credentials.

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
AI_PORT=8001

# PostgreSQL
POSTGRES_USER=investwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=investwatch

# Object storage (S3 API)
S3_ACCESS_KEY=change-me-access
S3_SECRET_KEY=change-me-secret
S3_BUCKET=evidence

# Samples directory mounted read-only into the backend (point at the pendrive to import it)
SAMPLES_HOST_DIR=./samples
SEED_ON_START=true

# Alerts and scraping
ALERT_THRESHOLD=70
PROXY_URLS=
RESCAN_CRON=0 */6 * * *
REGISTRY_REFRESH_CRON=30 3 * * *
DISCOVERY_CRON=15 */6 * * *
RESCAN_SAMPLES=false
RESPECT_ROBOTS=true
WORKER_CONCURRENCY=2
LOG_LEVEL=INFO

# Local LLM (optional). Off = deterministic rules + embeddings only.
LLM_ENABLED=false
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:e4b
EMBEDDINGS_BACKEND=hash
OLLAMA_EMBED_MODEL=embeddinggemma:300m
LLM_TIMEOUT_S=60

# Public report form (/zglos): limits per reporter (salted hash of the IP) and scans started by reports.
PUBLIC_REPORTS_PER_HOUR=20
PUBLIC_REPORTS_MAX_QUEUED=50
PUBLIC_REPORTS_SALT=

# Login. APP_ENV=production refuses to start with an empty or placeholder JWT_SECRET
# (generate one: openssl rand -hex 32). Empty JWT_SECRET + DEMO_LOGIN=true = random secret per start.
APP_ENV=development
JWT_SECRET=
JWT_EXPIRE_HOURS=8
COOKIE_SECURE=auto
DEMO_LOGIN=true
DEMO_ANALYST_EMAIL=analityk@uknf.local
DEMO_ANALYST_PASSWORD=change-me-analyst
DEMO_SUPERVISOR_EMAIL=kierownik@uknf.local
DEMO_SUPERVISOR_PASSWORD=change-me-supervisor
