# Copy to .env and change the values. These are placeholders, not real credentials.

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
AI_PORT=8001

# PostgreSQL
POSTGRES_USER=investwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=investwatch

# Object storage (S3 API)
S3_ACCESS_KEY=change-me-access
S3_SECRET_KEY=change-me-secret
S3_BUCKET=evidence

# Samples directory mounted read-only into the backend (point at the pendrive to import it)
SAMPLES_HOST_DIR=./samples
SEED_ON_START=true

# Alerts and scraping
ALERT_THRESHOLD=70
PROXY_URLS=
RESCAN_CRON=0 */6 * * *
REGISTRY_REFRESH_CRON=30 5 * * *

# Local LLM (optional). Off = deterministic rules + embeddings only.
LLM_ENABLED=false
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=
