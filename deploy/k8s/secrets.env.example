# Copy to secrets.env (ignored by git) and replace every value.
# Generate random values with: openssl rand -hex 32
POSTGRES_USER=investwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=investwatch
S3_ACCESS_KEY=change-me-access
S3_SECRET_KEY=change-me-secret
# Min. 32 characters. Empty = random secret on every backend start (sessions end on restart).
JWT_SECRET=
PUBLIC_REPORTS_SALT=
# Empty password = account usable only through the demo login buttons.
DEMO_ANALYST_PASSWORD=change-me-analyst
DEMO_SUPERVISOR_PASSWORD=change-me-supervisor
