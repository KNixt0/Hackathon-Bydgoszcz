# Copy to deploy/azure/config.env (git-ignored by you, do not commit) or export in the shell.
# Every variable is optional; the defaults are shown.

# Subscription name or id. Empty = the current `az account` default.
AZ_SUBSCRIPTION=
# Region. Pick one close to the audience; prices and VM availability differ per region.
AZ_LOCATION=polandcentral
AZ_RESOURCE_GROUP=rg-investwatch-demo
AZ_VM_NAME=vm-investwatch
# 4 vCPU / 16 GB: enough for the whole stack WITHOUT a local model.
# For the local model (ENABLE_LLM=yes) use a larger size, e.g. Standard_D8s_v5 (8 vCPU / 32 GB).
AZ_VM_SIZE=Standard_D4s_v5
AZ_ADMIN_USER=azureuser
# Path to the PUBLIC key. If the file is missing, az generates a key pair (--generate-ssh-keys).
AZ_SSH_KEY=$HOME/.ssh/id_rsa.pub
# Who may reach ports 22 and 80. Default: your current public IP as /32.
# The dashboard has no login: do not open it to the world.
AZ_ALLOW_CIDR=
# Required to accept 0.0.0.0/0 (anyone on the internet).
AZ_ALLOW_PUBLIC=no
AZ_OS_DISK_GB=64
# Local LLM (Ollama) on the VM, CPU only and slow.
ENABLE_LLM=no
OLLAMA_MODEL=gemma4:e4b
# Skip the interactive question in 01/99 scripts.
CONFIRM=no
