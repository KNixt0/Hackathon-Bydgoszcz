#!/usr/bin/env bash
# One entry point for the swarm. Run ./swarm with no arguments for help.
set -euo pipefail
cd "$(dirname "$0")"

role() { python3 scripts/roles.py "$@"; }
b() { printf '\033[1m%s\033[0m' "$*"; }

usage() {
  cat <<EOF
$(b "./swarm") — sterowanie swarmem agentów

  $(b view)            animowany podgląd na żywo (otwiera przeglądarkę)
  $(b status)          stan kolejki zadań i PR-ów w terminalu
  $(b roles)           kto co robi, jaki model i effort

  $(b work) [--loop]   budowniczy: bierze następne zadanie i je robi   (każdy)
  $(b team) [N]        lead zespołu agentów na tym laptopie, N zadań   (każdy)
  $(b plan)            planer: plan.md → kontrakty → zadania           (KNixt0)
  $(b lead)            lead: tylko deleguje i merguje                  (KNixt0)

  $(b setup)           sprawdza gh, claude, python i zaufanie folderu
EOF
}

run_claude() {  # <role> <prompt-file> [sed-expr]
  local m e prompt
  read -r m e < <(role "$1")
  prompt=$(sed "${3:-}" "$2")
  echo "▶ $1 · model $m · effort $e"
  exec claude --model "$m" --effort "$e" "$prompt"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  view)   exec python3 dashboard/server.py --open "$@" ;;
  plan)   run_claude planner coord/prompts/planner.md ;;
  lead)   run_claude lead coord/prompts/lead.md ;;
  team)   run_claude builder coord/prompts/team-lead.md "s/{{N:-3}}/${1:-3}/g" ;;
  work)   exec ./scripts/worker.sh "$@" ;;
  roles)  role table ;;
  status)
    echo "$(b Zadania)"
    for s in ready claimed review blocked needs-decision; do
      n=$(gh issue list --state open --label "status:$s" --json number --jq length)
      printf '  %-16s %s\n' "$s" "$n"
    done
    echo "$(b 'Otwarte PR-y')"
    prs=$(gh pr list --json number,title,author,labels \
      --jq '.[] | "  #\(.number)  \(.author.login)  \(.title)\(if any(.labels[]; .name=="needs:owner-review") then "  [czeka na KNixt0]" else "" end)"')
    echo "${prs:-  (brak)}"
    ;;
  setup)
    ok=1
    for t in gh claude python3 git; do
      if command -v "$t" >/dev/null; then echo "✓ $t"; else echo "✗ brakuje $t"; ok=0; fi
    done
    if gh auth status >/dev/null 2>&1; then echo "✓ gh zalogowany jako $(gh api user --jq .login)"; else echo "✗ zaloguj: gh auth login"; ok=0; fi
    echo "• Uruchom raz 'claude' w tym folderze i zaakceptuj „trust this folder” (inaczej worker nie dostanie uprawnień)."
    echo
    role table
    [[ $ok == 1 ]] && echo && echo "Gotowe. Zacznij od: ./swarm view"
    ;;
  help|-h|--help) usage ;;
  *) echo "Nieznana komenda: $cmd"; echo; usage; exit 1 ;;
esac
