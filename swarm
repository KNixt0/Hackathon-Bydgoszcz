#!/usr/bin/env bash
# One entry point for the swarm. Run ./swarm with no arguments for help.
set -euo pipefail
cd "$(dirname "$0")"

role() { python3 scripts/roles.py "$@"; }
b() { printf '\033[1m%s\033[0m' "$*"; }

usage() {
  cat <<EOF
$(b "./swarm") — sterowanie swarmem agentów

  $(b view)            animowany podgląd na żywo (otwiera przeglądarkę)
  $(b status)          stan kolejki zadań i PR-ów w terminalu
  $(b roles)           kto co robi, jaki model i effort
  $(b agents)          kto jest online: operator, narzędzie, model, poziom
  $(b checkin) [opcje] zamelduj swojego agenta (--tool --model --tier --status)
  $(b rollcall)        zapytaj wszystkich agentów „kto cię obsługuje?”

  $(b tasks)           wolne zadania z obszarem (area:…) i trudnością
  $(b claim) N         weź zadanie N do pracy ręcznej (np. w Cursorze / Antigravity)
  $(b done) N ["opis"] sprawdź, wypchnij i otwórz PR dla zadania N
  $(b unclaim) N       oddaj zadanie N z powrotem do puli

  $(b work) [opcje]    budowniczy: bierze kolejne zadania i je robi     (każdy)
      --area ui,docs     tylko te obszary: ui|frontend, api|backend, ai, devops, docs
      --tool codex       inne narzędzie: claude (domyślnie) | codex | gemini | custom
      --model gpt-5      model;  --tier strong|standard|light;  --loop = bez końca
  $(b team) [N]        lead zespołu agentów na tym laptopie, N zadań   (każdy)
  $(b plan)            planer: plan.md → kontrakty → zadania           (KNixt0)
  $(b lead)            lead: tylko deleguje i merguje                  (KNixt0)

  $(b setup)           sprawdza gh, claude, python i zaufanie folderu
EOF
}

run_claude() {  # <role> <prompt-file> [sed-expr]
  local m e prompt
  read -r m e < <(role "$1")
  prompt=$(sed "${3:-}" "$2")
  echo "▶ $1 · model $m · effort $e"
  exec claude --model "$m" --effort "$e" "$prompt"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  view)   exec python3 dashboard/server.py --open "$@" ;;
  plan)   run_claude planner coord/prompts/planner.md ;;
  lead)   run_claude lead coord/prompts/lead.md ;;
  team)   run_claude builder coord/prompts/team-lead.md "s/{{N:-3}}/${1:-3}/g" ;;
  work)
    args=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --area|--areas) export SWARM_AREAS="$2"; shift 2 ;;
        --tool)  export SWARM_TOOL="$2"; shift 2 ;;
        --model) export SWARM_MODEL="$2"; shift 2 ;;
        --tier)  export SWARM_TIER="$2"; shift 2 ;;
        *) args+=("$1"); shift ;;
      esac
    done
    echo "▶ worker · ${SWARM_TOOL:-claude} ${SWARM_MODEL:-(model z roles.json)} · poziom ${SWARM_TIER:-auto} · obszary ${SWARM_AREAS:-wszystkie}"
    exec ./scripts/worker.sh "${args[@]+"${args[@]}"}" ;;
  tasks)
    gh issue list --state open --label status:ready --limit 100 --json number,title,labels,assignees \
      --jq '.[] | "  #\(.number)  [\([.labels[].name | select(startswith("area:") or . == "model:opus" or . == "size:xs" or . == "prio:high")] | join(" "))]  \(.title)\(if (.assignees|length)>0 then "  → zarezerwowane: " + ([.assignees[].login]|join(",")) else "" end)"' \
      | { out=$(cat); echo "${out:-  (brak wolnych zadań)}"; } ;;
  roles)  role table ;;
  checkin) exec ./scripts/checkin.sh "$@" ;;
  claim)
    [[ -n "${1:-}" ]] || { echo "użycie: ./swarm claim <nr zadania>"; exit 1; }
    out=$(./scripts/claim.sh "$1" "${SWARM_TOOL:-manual}") || exit 1
    wt=$(sed -n 's/^WORKTREE=//p' <<<"$out"); br=$(sed -n 's/^BRANCH=//p' <<<"$out")
    echo "Zadanie #$1 jest Twoje. Gałąź: $br"
    echo "Otwórz ten folder w swoim edytorze (Cursor / Antigravity / VS Code):"
    echo "  $wt"
    echo "Gdy skończysz: ./swarm done $1"
    ;;
  done)
    [[ -n "${1:-}" ]] || { echo "użycie: ./swarm done <nr zadania>"; exit 1; }
    n="$1"; wt=".worktrees/$n"; [[ -d "$wt" ]] || { echo "brak $wt (najpierw ./swarm claim $n)"; exit 1; }
    me=$(gh api user --jq .login)
    (cd "$wt" && bash scripts/check.sh) || { echo "check.sh nie przechodzi — popraw i spróbuj ponownie"; exit 1; }
    (cd "$wt" && git add -A && { git diff --cached --quiet || git commit -q -m "#$n ${2:-work on task}"; } && git push -q -u origin HEAD)
    body=$(printf 'Closes #%s\n\n%s\n\n```yaml\nstatus: done\nagent: %s/%s-%s\nmodel: %s\nissue: %s\nchanged: [%s]\ncontracts_touched: none\nblockers: []\nnext: ""\n```\n' \
      "$n" "${2:-}" "$me" "${SWARM_TOOL:-manual}" "${SWARM_MODEL:-human}" "${SWARM_MODEL:-human}" "$n" \
      "$(cd "$wt" && git diff --name-only origin/main...HEAD | paste -sd, - | sed 's/,/, /g')")
    (cd "$wt" && gh pr create --fill --body "$body") && \
      gh issue edit "$n" --add-label status:review --remove-label status:claimed >/dev/null && \
      echo "PR otwarty, zadanie #$n → status:review. Recenzja: CI, Claude, potem KNixt0."
    ;;
  unclaim)
    [[ -n "${1:-}" ]] || { echo "użycie: ./swarm unclaim <nr zadania>"; exit 1; }
    gh issue edit "$1" --remove-assignee @me --add-label status:ready --remove-label status:claimed >/dev/null
    gh issue comment "$1" --body "Oddaję zadanie. Stan: ${2:-bez zmian w repo}" >/dev/null
    echo "Zadanie #$1 wróciło do puli (status:ready)."
    ;;
  rollcall)
    n=$(gh issue list --state open --label swarm:roster --json number --jq '.[0].number // empty')
    [[ -n "$n" ]] || { echo "brak issue z etykietą swarm:roster"; exit 1; }
    gh issue comment "$n" --body "Roll call: who operates you? Answer with the check-in block (coord/PROTOCOL.md §0)." >/dev/null
    echo "Zapytano na #$n. Odpowiedzi zobaczysz w: ./swarm agents"
    ;;
  agents)
    gh issue list --state open --label swarm:roster --limit 1 --json number,comments | python3 -c '
import json, sys, datetime as dt
sys.path.insert(0, "dashboard"); from server import parse_roster
now = dt.datetime.now(dt.timezone.utc)
rows = parse_roster(json.load(sys.stdin))
if not rows: print("  nikt się jeszcze nie zameldował (./swarm checkin)")
for a in rows:
    age = (now - dt.datetime.fromisoformat(a["at"].replace("Z", "+00:00"))).total_seconds() / 60
    st = "offline" if a.get("checkin") == "offline" or age > 30 else a.get("checkin")
    w = a.get("working_on") or "none"
    work = " #" + w if st == "busy" and w != "none" else ""
    name, tier, tool, model = a["agent"], a.get("tier", "?"), a.get("tool", "?"), a.get("model", "?")
    print(f"  {st:8} {name:36} {tier:9} {tool}/{model}{work}  ({int(age)} min temu)")
'
    ;;
  status)
    echo "$(b Zadania)"
    for s in ready claimed review blocked needs-decision; do
      n=$(gh issue list --state open --label "status:$s" --json number --jq length)
      printf '  %-16s %s\n' "$s" "$n"
    done
    echo "$(b 'Otwarte PR-y')"
    prs=$(gh pr list --json number,title,author,labels \
      --jq '.[] | "  #\(.number)  \(.author.login)  \(.title)\(if any(.labels[]; .name=="needs:owner-review") then "  [czeka na KNixt0]" else "" end)"')
    echo "${prs:-  (brak)}"
    ;;
  setup)
    ok=1
    for t in gh claude python3 git; do
      if command -v "$t" >/dev/null; then echo "✓ $t"; else echo "✗ brakuje $t"; ok=0; fi
    done
    if gh auth status >/dev/null 2>&1; then echo "✓ gh zalogowany jako $(gh api user --jq .login)"; else echo "✗ zaloguj: gh auth login"; ok=0; fi
    echo "• Uruchom raz 'claude' w tym folderze i zaakceptuj „trust this folder” (inaczej worker nie dostanie uprawnień)."
    echo
    role table
    [[ $ok == 1 ]] && echo && echo "Gotowe. Zacznij od: ./swarm view"
    ;;
  help|-h|--help) usage ;;
  *) echo "Nieznana komenda: $cmd"; echo; usage; exit 1 ;;
esac
